# JalLekha — environment variable NAMES only (never commit real values).
# The public demo requires NONE of these: it is a static, browser-local build.

# ---- Optional runtime AI (server-only; keep OFF for public demos) ----
# AI_MODE=disabled|live            # disabled by default; live needs a verified plan
# ZAI_API_KEY=                     # server-side secret; never expose to the browser
# ZAI_MODEL=                       # verify model eligibility for your plan first
# ZAI_BASE_URL=                    # e.g. https://api.z.ai/api/paas/v4 (verify current docs)

# ---- Future shared backend (not enabled in this build) ----
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=       # server-only; never browser-exposed
