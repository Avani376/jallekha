{
  "name": "jallekha",
  "version": "1.3.0",
  "private": true,
  "description": "Water delivery and consumption reconciliation for campuses and housing societies — deterministic balance, uncertainty bounds, verification cases, documented audit trail.",
  "author": "Team SevaForge",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "node scripts/preflight-check.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "build:static": "cross-env NEXT_STATIC=1 next build && node scripts/fix-static-prefetch.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Avani376/jallekha"
  },
  "keywords": [
    "water-accounting",
    "reconciliation",
    "uncertainty",
    "audit-trail",
    "civic-tech"
  ],
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
